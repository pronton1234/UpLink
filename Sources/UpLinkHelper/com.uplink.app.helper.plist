<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.uplink.app.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/com.uplink.app.helper</string>
    <key>MachServices</key>
    <dict>
        <key>com.uplink.app.helper</key>
        <true/>
    </dict>
    <!-- Belt-and-braces. configd's ISPreference plugin is what actually
         restores Internet Sharing at boot; this is here so the access point
         also comes back if the preference was never the thing that carried it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
