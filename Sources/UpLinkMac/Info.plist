<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Required for an AppKit app with no main nib. Without it the app still
	     launches, but the bundle is not a well-formed application, which is the
	     kind of thing sysextd validates before trusting an extension inside. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category-utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>UpLink</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu bar app: no Dock icon by default. The HIG warns against a
	     menu-bar-only UI, so the Devices window is reachable from the menu
	     and the app activates properly when it opens. -->
	<key>LSUIElement</key>
	<true/>
	<!-- REQUIRED on macOS 15+, and denied silently without it.
	     The proxy extension dials the phone at its address on the network this
	     Mac hosts — 192.168.2.2 — which is local network access, and macOS now
	     gates that the same way iOS does.
	     Measured 2026-08-20: `nc` from Terminal reached 192.168.2.2:50505
	     immediately, while the extension's dial to the identical address and
	     port timed out at 12s with NOTHING arriving at the phone. Terminal had
	     been granted; the extension never had. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>UpLink connects to your iPhone over the network this Mac hosts. Nothing is sent to any server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uplink._tcp</string>
	</array>
</dict>
</plist>
