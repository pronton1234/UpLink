<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOT sandboxed, deliberately: a sandboxed app cannot enumerate or
	     install a system extension. The extension itself IS sandboxed, which is
	     where the untrusted network data is handled. Verified against how
	     Tailscale ships. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>app-proxy-provider-systemextension</string>
	</array>
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<!-- Required by NetworkExtension, not by us: NEMachServiceName must be
	     prefixed with an App Group from this entitlement, or the extension is
	     rejected with "invalid NEMachServiceName key". The team-identifier
	     prefix is NOT accepted. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.uplink.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.uplink.app</string>
	</array>
</dict>
</plist>
